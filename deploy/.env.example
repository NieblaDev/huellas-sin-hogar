# ============================================================
# Configuración de despliegue - Huellas Sin Hogar
# Copia este archivo como `deploy/.env` y ajusta los valores.
# NUNCA subas el .env real al repositorio.
# ============================================================

# --- Base de datos PostgreSQL (contenedor `db`) ---
POSTGRES_DB=huellas_sin_hogar
POSTGRES_USER=huellas
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA

# --- Backend ---
# Genera uno con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO

# Origen permitido para CORS. Déjalo vacío si el frontend se sirve
# desde el mismo dominio (recomendado). Ejemplo con dominio propio:
# CORS_ORIGIN=https://huellas.facultad.edu
CORS_ORIGIN=

# Ejecutar el seed solo la PRIMERA vez (crea usuarios y datos de ejemplo).
# Cámbialo a false después del primer arranque.
RUN_SEED=false

# --- Frontend ---
# URL de la API que se compila dentro del frontend.
# Con Nginx en el mismo dominio, usa la ruta relativa:
VITE_API_URL=/api

# --- Red ---
# Puerto público donde escucha Nginx.
HTTP_PORT=80
