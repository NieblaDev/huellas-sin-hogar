{
  "name": "huellas-sin-hogar-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:push": "prisma db push",
    "prisma:deploy": "npm run prisma:push",
    "prisma:migrate": "npm run prisma:push",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:reset": "node prisma/seed.js --reset",
    "start:prod": "pm2-runtime ecosystem.config.cjs",
    "test:unit": "node --test tests/*.schema.test.js tests/app.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pm2": "^6.0.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  },
  "engines": {
    "node": "24.x"
  }
}
